# Copy to .env and fill in. Never commit the real .env.

# --- AI ---
# Which provider/model the engine uses to write and respond to messages.
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=

# --- Database (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Phone / Twilio (SMS + voice) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Comma-separated list of our sending numbers in E.164, e.g. +15125551234
OUTREACH_PHONE_NUMBERS=

# --- Email ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# --- Sending guardrails ---
# Hard caps so a bad config can't blast all 15k at once.
MAX_EMAILS_PER_DAY=500
MAX_SMS_PER_DAY=200
MAX_CALLS_PER_DAY=100
DRY_RUN=true
