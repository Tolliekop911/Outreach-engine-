# Copy to .env and fill in. Never commit the real .env.

# --- AI ---
# Which model writes and responds to messages. Default is the most capable.
# For bulk generation (e.g. 15k leads) you may set a cheaper model, e.g.
# claude-sonnet-5-5 or claude-haiku-5-5.
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
ANTHROPIC_API_KEY=

# --- Outreach brand/offer context (drives AI message content) ---
# Keep the pitch here, never hardcoded in prompts. One platform, many clinics.
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_TITLE=
OUTREACH_PRODUCT=
OUTREACH_VALUE_PROP=
OUTREACH_CTA=
OUTREACH_CTA_URL=
# Interested ("hot") leads are flagged for a human; if set, a notification
# email is sent here instead of auto-replying to the lead.
OUTREACH_HANDOFF_EMAIL=

# --- Database (Supabase) ---
# Shared "Cowboy Mind" Supabase project; this app uses only the isolated
# "outreach" schema and never touches the public schema.
SUPABASE_URL=https://vxenhdvnkeagpopkmetu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DB_SCHEMA=outreach

# --- Phone / Twilio (SMS + voice) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Comma-separated list of our sending numbers in E.164, e.g. +15125551234
OUTREACH_PHONE_NUMBERS=
# Point your Twilio number's inbound Messaging webhook at /webhooks/sms so STOP
# opt-outs and replies are captured. Needs A2P 10DLC registration for US sending.

# --- Email ---
# Provider adapter: "console" (logs, no send), "smtp" (Namecheap Private Email
# or any mailbox), or "sendgrid".
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Physical mailing address required in every email footer (CAN-SPAM).
EMAIL_POSTAL_ADDRESS=

# SMTP (Namecheap Private Email). Defaults suit privateemail.com; port 465
# (SSL) or 587 (STARTTLS, set SMTP_SECURE=false). SMTP_USER is the full mailbox
# address and is normally the same as EMAIL_FROM_ADDRESS.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Only for EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=

# --- Tracking / links ---
# Public base URL where the webhook server is reachable (open pixel, click
# redirects, unsubscribe), e.g. https://outreach.yourdomain.com
TRACKING_BASE_URL=
# Secret used to sign tracking and unsubscribe tokens so they can't be forged.
TRACKING_SECRET=
# Port for the local webhook server.
PORT=3000

# --- Admin dashboard ---
# Password for the /dashboard admin UI. If unset, the admin API is disabled.
ADMIN_PASSWORD=

# --- Sending guardrails ---
# Hard caps so a bad config can't blast all 15k at once.
MAX_EMAILS_PER_DAY=500
MAX_SMS_PER_DAY=200
MAX_CALLS_PER_DAY=100
DRY_RUN=true
